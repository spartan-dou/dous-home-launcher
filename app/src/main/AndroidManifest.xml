<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Status bar: Wi-Fi or Ethernet -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Continue watching": the programs apps publish to the Android TV home screen -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- "Uninstall" in the menu of an app: only asks the system, which asks the user -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Self-update: installs the APK of the latest GitHub release (the system asks once to allow it) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Tablet: the photo frame comes back when the screen goes off on the charger (FrameKeeper) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <!-- Opening the frame from the background (screen just gone off): granted in the settings -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ only lists the apps a launcher declares it wants to see -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: "continue watching" pictures come from local servers over plain HTTP
         (e.g. Jellyfin at http://192.168.x.x:8096) -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Launcher">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- noHistory: closed as soon as it is left, so its album list never stays in memory -->
        <activity
            android:name=".SettingsActivity"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true"
            android:label="@string/settings_name"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The photo frame as an app: the icon a tablet shows, and what Home Assistant's app opens.
             Its own task, so opening it never brings the home screen along -->
        <activity
            android:name=".FrameActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:label="@string/frame_name"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.spartandou.launcher.frame">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The photo frame as the screensaver, chosen in the system settings (the TV) -->
        <service
            android:name=".FrameDream"
            android:exported="true"
            android:icon="@drawable/banner"
            android:label="@string/frame_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream" />
        </service>

        <!-- Remote buttons remapped to apps (the Netflix one): needs to be turned on in the
             accessibility settings, like Key Mapper -->
        <service
            android:name=".KeyService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

        <!-- Tablet: brings the photo frame back when the screen goes off on the charger -->
        <service
            android:name=".FrameKeeper"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Photo frame shown again whenever the screen goes off while charging" />
        </service>

        <!-- Exported for SCREEN_OFF, sent by Home Assistant's app (command_broadcast_intent) -->
        <receiver
            android:name=".KeeperStarter"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <action android:name="io.github.spartandou.launcher.SCREEN_OFF" />
            </intent-filter>
        </receiver>

        <!-- Device admin, only to turn the screen off when Home Assistant asks (force-lock) -->
        <receiver
            android:name=".FrameKeeper$Admin"
            android:exported="true"
            android:label="@string/frame_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/frame_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Result of the update installation: asks the user to confirm when the system wants it -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.spartandou.launcher.UPDATE_RESULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
