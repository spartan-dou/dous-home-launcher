<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Two slides that cross-fade: a blurred backdrop (portrait photos only) and the photo -->
    <FrameLayout
        android:id="@+id/slides"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/slide" />

        <include layout="@layout/slide" />
    </FrameLayout>

    <!-- Darken the band of the clock and the band of the apps; swapped when the apps are on top -->
    <View
        android:id="@+id/top_scrim"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/scrim_top" />

    <View
        android:id="@+id/bottom_scrim"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:id="@+id/clock_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="56dp"
        android:orientation="vertical">

        <TextClock
            style="@style/ShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:textSize="76sp" />

        <TextClock
            style="@style/ShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:alpha="0.85"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:letterSpacing="0.04"
            android:textSize="16sp" />

        <!-- Today's weather, or tomorrow's in the evening -->
        <TextView
            android:id="@+id/weather"
            style="@style/ShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:alpha="0.9"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The corner the clock leaves free: status pill, then the photo place and date -->
    <LinearLayout
        android:id="@+id/info_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginStart="36dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="36dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- Status icons, shadowed like the clock (no glass: it competed with the photo) -->
        <LinearLayout
            android:id="@+id/status_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <!-- Photo place and date: place in medium weight, date smaller and softer -->
        <LinearLayout
            android:id="@+id/caption_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/caption"
                style="@style/ShadowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="380dp"
                android:maxLines="1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/caption_date"
                style="@style/ShadowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:letterSpacing="0.03"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="28dp"
        android:orientation="vertical">

        <!-- One band per row (title, glass, scroller), built in code -->
        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- All apps over a full-screen frosted copy of the photo; the grid is built on first open only -->
    <FrameLayout
        android:id="@+id/all_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <io.github.spartandou.launcher.GlassView
            android:id="@+id/all_apps_glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            style="@style/ShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:layout_marginTop="36dp"
            android:fontFamily="sans-serif-light"
            android:text="@string/all_apps"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="60dp"
            android:text="@string/all_apps_hint"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="96dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="5"
                android:paddingTop="12dp"
                android:paddingBottom="48dp" />
        </ScrollView>
    </FrameLayout>
</FrameLayout>
