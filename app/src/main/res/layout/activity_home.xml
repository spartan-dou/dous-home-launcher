<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Two slides that cross-fade: a blurred backdrop (portrait photos only) and the photo -->
    <FrameLayout
        android:id="@+id/slides"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/slide" />

        <include layout="@layout/slide" />
    </FrameLayout>

    <!-- Darken the band of the clock and the band of the apps; swapped when the apps are on top -->
    <View
        android:id="@+id/top_scrim"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/scrim_top" />

    <!-- Tall and dark: the apps float on it without a band of their own -->
    <View
        android:id="@+id/bottom_scrim"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <!-- Compact clock: the time, and beside it the date, the weather and the photo's place -->
    <LinearLayout
        android:id="@+id/clock_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            style="@style/ShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:textSize="60sp" />

        <LinearLayout
            android:id="@+id/clock_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:orientation="vertical">

            <TextClock
                style="@style/ShadowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM"
                android:letterSpacing="0.16"
                android:textAllCaps="true"
                android:textSize="13sp" />

            <!-- Today's weather, or tomorrow's in the evening, with a line icon -->
            <TextView
                android:id="@+id/weather"
                style="@style/ShadowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:drawablePadding="7dp"
                android:fontFamily="sans-serif-light"
                android:gravity="center_vertical"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Photo place and date, filled by the photo wall -->
            <LinearLayout
                android:id="@+id/caption_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:alpha="0"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="7dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_place" />

                <TextView
                    android:id="@+id/caption"
                    style="@style/ShadowText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-light"
                    android:maxWidth="380dp"
                    android:maxLines="1"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/caption_date"
                    style="@style/ShadowText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:fontFamily="sans-serif-light"
                    android:maxLines="1"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- The corner the clock leaves free: the Shield settings, alerts only when something is wrong -->
    <LinearLayout
        android:id="@+id/info_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginStart="36dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="36dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- Status icons, shadowed like the clock (no glass: it competed with the photo) -->
        <LinearLayout
            android:id="@+id/status_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- "New" panel: one poster at a time from the apps' channels, filled in code -->
    <FrameLayout
        android:id="@+id/news_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="66dp"
        android:layout_marginEnd="48dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="6dp" />

    <!-- paddingTop: room above the first title line, where a focused round button grows -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="28dp"
        android:orientation="vertical">

        <!-- One band per row (title, floating tiles, focused app name), built in code -->
        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- All apps over a full-screen frosted copy of the photo; the grid is built on first open only -->
    <FrameLayout
        android:id="@+id/all_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <io.github.spartandou.launcher.GlassView
            android:id="@+id/all_apps_glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            style="@style/ShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:layout_marginTop="36dp"
            android:fontFamily="sans-serif-light"
            android:text="@string/all_apps"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="60dp"
            android:text="@string/all_apps_hint"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="96dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="5"
                android:paddingTop="12dp"
                android:paddingBottom="48dp" />
        </ScrollView>
    </FrameLayout>
</FrameLayout>
