<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Two slides that cross-fade: a blurred backdrop (portrait photos only) and the photo -->
    <FrameLayout
        android:id="@+id/slides"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/slide" />

        <include layout="@layout/slide" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/scrim_top" />

    <View
        android:id="@+id/bottom_scrim"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <TextClock
            style="@style/ShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:textSize="76sp" />

        <TextClock
            style="@style/ShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:alpha="0.85"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:letterSpacing="0.04"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Photo place and date, in a glass pill -->
    <FrameLayout
        android:id="@+id/caption_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="56dp"
        android:alpha="0">

        <io.github.spartandou.launcher.GlassView
            android:id="@+id/caption_glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="420dp"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:textColor="#F2FFFFFF"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="28dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/focused_label"
            style="@style/ShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="68dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:textSize="17sp" />

        <!-- Glass bar behind the apps row -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <io.github.spartandou.launcher.GlassView
                android:id="@+id/dock_glass"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fadingEdgeLength="0dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="16dp" />
            </HorizontalScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- All apps over a full-screen frosted copy of the photo; the grid is built on first open only -->
    <FrameLayout
        android:id="@+id/all_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <io.github.spartandou.launcher.GlassView
            android:id="@+id/all_apps_glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            style="@style/ShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:layout_marginTop="36dp"
            android:fontFamily="sans-serif-light"
            android:text="@string/all_apps"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="60dp"
            android:text="@string/all_apps_hint"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="96dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="5"
                android:paddingTop="12dp"
                android:paddingBottom="48dp" />
        </ScrollView>
    </FrameLayout>
</FrameLayout>
