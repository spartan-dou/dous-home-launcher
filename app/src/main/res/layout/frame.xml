<?xml version="1.0" encoding="utf-8"?>
<!-- The photo frame: the photos, the clock, and what Home Assistant sends -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/slides"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/slide" />

        <include layout="@layout/slide" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/scrim_top" />

    <include layout="@layout/clock" />

    <!-- Notifications, newest on top, built in code -->
    <LinearLayout
        android:id="@+id/notes"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="36dp"
        android:orientation="vertical" />

    <!-- Touch only: shown by a tap, built in code -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:alpha="0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone" />
</FrameLayout>
