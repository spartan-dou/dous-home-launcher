<?xml version="1.0" encoding="utf-8"?>
<!-- The photo frame: the photos (whole, on their blurred copy), the clock as on the home screen,
     a frosted card with the photo's date and place, and Home Assistant's notifications -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/slides"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/slide" />

        <include layout="@layout/slide" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:alpha="0.75"
        android:background="@drawable/scrim_bottom" />

    <!-- The clock, as on the home screen but airier: a large thin time, beside it the date in
         spaced small capitals, the weather reduced to its icon and temperatures, and the values
         Home Assistant sends. Their tint follows the photo (Frame.setAmbient) -->
    <LinearLayout
        android:id="@+id/clock_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="56dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Tapped: the launcher's home screen -->
        <TextClock
            android:id="@+id/frame_time"
            style="@style/ShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:fontFeatureSettings="tnum"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:textSize="76sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/frame_date"
                style="@style/ShadowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM"
                android:letterSpacing="0.2"
                android:textAllCaps="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/weather"
                style="@style/ShadowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif-light"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- Built in code: emoji, value, smaller unit, each centred on the line -->
            <LinearLayout
                android:id="@+id/sensors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom right, in the clock's style: the photo's date in spaced small capitals over its
         place; filled by the photo wall, which fades it in with the photo -->
    <LinearLayout
        android:id="@+id/caption_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="36dp"
        android:alpha="0"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/caption_date"
                style="@style/ShadowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/caption_place_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="7dp"
                android:alpha="0.85"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_place" />

            <TextView
                android:id="@+id/caption"
                style="@style/ShadowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:maxWidth="520dp"
                android:maxLines="1"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Notifications, newest on top, pills built in code, top right: the clock has the left -->
    <LinearLayout
        android:id="@+id/notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="end"
        android:orientation="vertical" />

    <!-- Touch only: pause or play, shown a moment when the middle of the screen is tapped -->
    <ImageView
        android:id="@+id/pause_mark"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/mark_background"
        android:importantForAccessibility="no"
        android:padding="20dp" />
</FrameLayout>
